    <!-- Script de Interactividad Dinámica -->
    <script>
        const pricingData = {
            "2": {
                bcnH: "$560 – $720 USD", bcnA: "$520 – $680 USD",
                madH: "$1,330 – $1,820 USD", madA: "$1,190 – $1,680 USD",
                colH: "$300 – $420 USD", colA: "$260 – $360 USD",
                total: "$1,970 – $2,960 USD",
                perPerson: "$985 – $1,480 USD"
            },
            "3": {
                bcnH: "$760 – $960 USD", bcnA: "$680 – $880 USD",
                madH: "$1,750 – $2,380 USD", madA: "$1,540 – $2,170 USD",
                colH: "$400 – $560 USD", colA: "$360 – $480 USD",
                total: "$2,580 – $3,900 USD",
                perPerson: "$860 – $1,300 USD"
            },
            "4": {
                bcnH: "$1,000 – $1,280 USD", bcnA: "$880 – $1,200 USD",
                madH: "$2,380 – $3,360 USD", madA: "$2,030 – $2,940 USD",
                colH: "$560 – $760 USD", colA: "$480 – $660 USD",
                total: "$3,390 – $5,400 USD",
                perPerson: "$847 – $1,350 USD"
            }
        };

        function updateTravelers() {
            const val = document.getElementById("travelersSelect").value;
            const data = pricingData[val];

            // Animación visual rápida al cambiar
            const container = document.getElementById("citiesContainer");
            container.classList.remove("animate-fade-in");
            void container.offsetWidth; // Trigger reflow
            container.classList.add("animate-fade-in");

            // Actualizar textos de precios
            document.getElementById("bcnH").innerText = data.bcnH;
            document.getElementById("bcnA").innerText = data.bcnA;
            document.getElementById("madH").innerText = data.madH;
            document.getElementById("madA").innerText = data.madA;
            document.getElementById("colH").innerText = data.colH;
            document.getElementById("colA").innerText = data.colA;

            document.getElementById("totalRange").innerText = data.total;
            document.getElementById("perPersonRange").innerText = data.perPerson;
        }
    </script>
</body>
