            <!-- 3. COLONIA -->
            <div class="glass-effect rounded-2xl p-6 sm:p-8 shadow-xl border-l-8 border-indigo-600 transition-transform duration-300 hover:scale-[1.01]">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center border-b pb-4 mb-4 gap-2">
                    <div>
                        <h2 class="text-2xl font-bold text-purple-950">3. 🇩🇪 Colonia (CSD)</h2>
